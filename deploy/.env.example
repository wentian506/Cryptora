# ── CRYPTORA production environment ──────────────────────────────
# Copy to deploy/.env and fill in. NEVER commit the real .env.
#
#   cp deploy/.env.example deploy/.env
#   ./deploy/deploy.sh

# MySQL (used by docker-compose.prod.yml)
MYSQL_ROOT_PASSWORD=change-me-root-32-chars-min
MYSQL_DATABASE=cryptora
MYSQL_USER=cryptora
MYSQL_PASSWORD=change-me-32-chars-min

# Backend
CRYPTORA_JWT_SECRET=generate-with-openssl-rand-hex-32
CRYPTORA_JWT_TTL=86400
FRONTEND_ORIGIN=https://your-domain.com
DEV_MODE=false

# Google Sign-In (optional — get from Google Cloud Console → Credentials → OAuth client)
# Without this, the Google tab shows "not configured" and email/phone still work.
GOOGLE_CLIENT_ID=

# Phone OTP via SMS provider (optional — without it, DEV_MODE=true echoes test codes)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
